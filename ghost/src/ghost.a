* = $c000
	jmp main

; ***********
; ramcharcopy
; Makes a copy of the Char ROM to memory RAM location $3000
; ***********
r6510  = $0001                 ; R6510 I/O port register
newadr = $3000                 ; RAM destination for character set
chrbas = $d000                 ; Character ROM base address
ciacre = $dc0e                 ; CIA 1 control register A
c2ddra = $dd02                 ; CIA 2 data direction register A
vmcsb  = $d018                 ; VIC-II memory control register
chrout = $ffd2                 ; KERNAL character output routine
clrscr = $e544                 ; KERNAL clear screen routine

chara = newadr+$08             ; Character A position
charb = newadr+$10             ; Character B position
charc = newadr+$18             ; Character C position
chard = newadr+$20             ; Character D position
chare = newadr+$28             ; Character E position
charf = newadr+$30             ; Character F position
charg = newadr+$38             ; Character G position
charh = newadr+$40             ; Character H position
chari = newadr+$48             ; Character I position

; basic pointers
fretop = $0034                 ; Top of BASIC memopry (high-byte)
memsiz = $0038                 ; Size of BASIC memory (high byte)

tablen = $1000                 ; Length of the character set (4096 bytes)
mvsrce = $fb                   ; Move source pointer (low-byte)
mvdest = mvsrce+2              ; Move destination pointer (low-byte)

lenptr = $0200                 ; Block length pointer.

ramcharcopy:
; Set CIA2 data direction register as outputs to select the correct bank
	lda c2ddra
	ora #$03
	sta c2ddra

; For uppercase and graphics mode. Equivalent to BASIC PRINT CHR$(142)
; Clear the screen. Equivalent to BASIC PRINT CHR$(147): Is its own routine specifically for this.
	lda #142
	jsr chrout
	jsr clrscr

; Reserve RAM $3000 -- Make sure BASIC doesn't use anything lower.
	lda #$30
	sta fretop
	sta memsiz
; Turn off keyboard interrupt timer
	lda ciacre
	and #$fe
	sta ciacre

; Switch I/O off, char ROM on
	lda r6510
	and #$fb
	sta r6510

; Set source pointer
	lda #<chrbas
	sta mvsrce
	lda #>chrbas
	sta mvsrce + 1

; Set destination pointer
	lda #<newadr
	sta mvdest
	lda #>newadr
	sta mvdest + 1

; Set block length
	lda #<tablen
	sta lenptr
	lda #>tablen
	sta lenptr + 1

; Start block copy
	ldy #0
	ldx lenptr + 1
	beq mvpart

mvpage:
	lda (mvsrce),y
	sta (mvdest),y
	iny
	bne mvpage
	inc mvsrce + 1
	inc mvdest + 1
	dex
	bne mvpage

mvpart:
	ldx lenptr
	beq mvexit

mvlast:
	lda (mvsrce),y
	sta (mvdest),y
	iny
	dex
	bne mvlast

mvexit:
; Switch I/O back in
	lda r6510
	ora #04
	sta r6510
; Turn keyboard back on
	lda ciacre
	ora #01
	sta ciacre
; Set VIC-II memory control register
	lda vmcsb
	and #$f0
	ora #$0c
	sta vmcsb

ramcharcopy_end:
	rts

;********************************
; Copy custom graphics into chars
;********************************
cpyghost:
	; Setup source and destination pointers
	lda #<ghostab
	sta mvsrce
	lda #>ghostab
	sta mvsrce + 1

	lda #<chara
	sta mvdest
	lda #>chara
	sta mvdest + 1

	ldx #9                        ; Copy 9 characters, 8 bytes each
cpyghost_charloop:
	ldy #0
cpyghost_byteloop:
	lda (mvsrce),y
	sta (mvdest),y
	iny
	cpy #8
	bne cpyghost_byteloop

	; Advance source pointer by 8 to move to the next character.
	clc
	lda mvsrce
	adc #8
	sta mvsrce
	bcc cpyghost_nocarry1
	inc mvsrce + 1

cpyghost_nocarry1:
	clc
	lda mvdest
	adc #8
	sta mvdest
	bcc cpyghost_nocarry2
	inc mvdest + 1

cpyghost_nocarry2:
	dex
	bne cpyghost_charloop

cpyghost_end:
	rts

; ******************
; Main program entry
; ******************
main:
	jsr ramcharcopy
	jsr cpyghost

	; Print out ABC to screen.
	lda #65
	jsr chrout
	lda #66
	jsr chrout
	lda #67
	jsr chrout
	lda #13
	jsr chrout

	; Print out DEF to screen.
	lda #68
	jsr chrout
	lda #69
	jsr chrout
	lda #70
	jsr chrout
	lda #13
	jsr chrout

	; Print out GHI to screen.
	lda #71
	jsr chrout
	lda #72
	jsr chrout
	lda #73
	jsr chrout
	lda #13
	jsr chrout

	rts

;----------------------------
; Ghost sprite data
;----------------------------
ghostab:
	; a top left
	!byte %00000111
	!byte %00011111
	!byte %00111111
	!byte %01111111
	!byte %01111111
	!byte %11111111
	!byte %11111100
	!byte %11111100

	; b top center
	!byte %11111111
	!byte %11111111
	!byte %11111111
	!byte %11111111
	!byte %11111111
	!byte %11111111
	!byte %11111111
	!byte %11111111

	; c top right
	!byte %11100000
	!byte %11111000
	!byte %11111100
	!byte %11111110
	!byte %11111110
	!byte %11111111
	!byte %00111111
	!byte %00111111

	; d mid left
	!byte %11111100
	!byte %11111100
	!byte %11111111
	!byte %11111111
	!byte %11100110
	!byte %11011001
	!byte %11111111
	!byte %11111111

	; e mid center
	!byte %11111111
	!byte %11111111
	!byte %11111111
	!byte %11111111
	!byte %01100110
	!byte %10011001
	!byte %11111111
	!byte %11111111

	; f mid right
	!byte %00111111
	!byte %00111111
	!byte %11111111
	!byte %11111111
	!byte %01100111
	!byte %10011011
	!byte %11111111
	!byte %11111111

	; g bottom left
	!byte %11111111
	!byte %11111110
	!byte %11111100
	!byte %01111000
	!byte %00111000
	!byte %00011000
	!byte %00110000
	!byte %00000000

	; h bottom center
	!byte %11111111
	!byte %11111111
	!byte %11100111
	!byte %11100111
	!byte %01000010
	!byte %00100100
	!byte %00100010
	!byte %00000000

	; i bottom right
	!byte %11111111
	!byte %01111111
	!byte %00111111
	!byte %00011110
	!byte %00011100
	!byte %00011000
	!byte %00001100
	!byte %00000000

